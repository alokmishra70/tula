NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Pooled URL at runtime, direct URL for migrations (same locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tula_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tula_dev

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated, tried in order: gemini, groq, mock.
LLM_PROVIDERS=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Storage: "local" writes to LOCAL_STORAGE_DIR and signs URLs against PUBLIC_API_URL.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage-local
PUBLIC_API_URL=http://localhost:3000
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tula-private
